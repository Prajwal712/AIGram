# ── Meta / Instagram Credentials ──────────────────────────────────────────────
# Get these from https://developers.facebook.com → Instagram Graph API
META_ACCESS_TOKEN="your_meta_access_token_here"
IG_USER_ID="your_instagram_user_id_here"

# ── Google Gemini API Key ─────────────────────────────────────────────────────
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Pollinations AI API Key ──────────────────────────────────────────────────
# Get this from https://enter.pollinations.ai
POLLINATIONS_API_KEY="your_pollinations_api_key_here"

# ── ImgBB API Key (Image Hosting) ────────────────────────────────────────────
# Get this from https://api.imgbb.com (sign up → get API key)
IMGBB_API_KEY="your_imgbb_api_key_here"
